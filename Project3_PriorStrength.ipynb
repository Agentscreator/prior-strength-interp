   {
    "cell_type": "code",
    "source": [
     "# \u2500\u2500 DEBUG: Check why 0 questions were kept, then re-filter \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
     "# Check token IDs and a few example P(correct) values\n",
     "print(f\"A_ID={A_ID}, B_ID={B_ID}\")\n",
     "c0, w0, s0 = RAW_QS[0]\n",
     "p1 = pc(make_ab(s0,c0,w0,True,\"neutral\"), True)\n",
     "p2 = pc(make_ab(s0,c0,w0,False,\"neutral\"), False)\n",
     "print(f\"Q0 P(correct|cor_A=True)={p1:.3f}, P(correct|cor_A=False)={p2:.3f}\")\n",
     "c1, w1, s1 = RAW_QS[1]\n",
     "p3 = pc(make_ab(s1,c1,w1,True,\"neutral\"), True)\n",
     "p4 = pc(make_ab(s1,c1,w1,False,\"neutral\"), False)\n",
     "print(f\"Q1 P(correct|cor_A=True)={p3:.3f}, P(correct|cor_A=False)={p4:.3f}\")\n",
     "\n",
     "# Show what the prompt looks like\n",
     "sample_prompt = make_ab(s0,c0,w0,True,\"neutral\")\n",
     "print(\"\\nSample prompt snippet:\")\n",
     "print(sample_prompt[-200:])\n",
     "\n",
     "# Check that A_ID/B_ID are actually the right tokens\n",
     "print(f\"\\nDecode A_ID: '{tok.decode([A_ID])}'\")\n",
     "print(f\"Decode B_ID: '{tok.decode([B_ID])}'\")\n",
     "\n",
     "# Re-filter with relaxed criterion: just one direction > 0.5\n",
     "kept = []\n",
     "p_cor_A_vals = []\n",
     "for c, w, s in RAW_QS:\n",
     "    pa = pc(make_ab(s,c,w,True,\"neutral\"), True)\n",
     "    p_cor_A_vals.append(pa)\n",
     "    if pa > 0.5:\n",
     "        kept.append((c,w,s))\n",
     "\n",
     "print(f\"\\nWith only cor_A=True filter: {len(kept)}/{len(RAW_QS)} kept\")\n",
     "print(f\"P(correct) distribution: min={min(p_cor_A_vals):.3f} mean={sum(p_cor_A_vals)/len(p_cor_A_vals):.3f} max={max(p_cor_A_vals):.3f}\")\n",
     "\n",
     "# Use this relaxed filter going forward\n",
     "HALF = len(kept)//2\n",
     "train_qs = kept[:HALF]\n",
     "test_qs = kept[HALF:]\n",
     "print(f\"Train:{len(train_qs)} Test:{len(test_qs)}\")\n",
     "\n",
     "# \u2500\u2500 4. Logit lens \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
     "CONDITIONS = [\"neutral\",\"mention\",\"weak\",\"strong\",\"expert\"]\n",
     "\n",
     "def logit_lens(ids):\n",
     "    with torch.no_grad():\n",
     "        out = model(ids, output_hidden_states=True)\n",
     "    rows = []\n",
     "    for h in out.hidden_states[1:]:\n",
     "        lg = model.lm_head(model.model.norm(h))[0,-1].float()\n",
     "        p = torch.softmax(lg, dim=-1)\n",
     "        rows.append((p[A_ID].item(), p[B_ID].item()))\n",
     "    return rows\n",
     "\n",
     "ll_res = {c: [] for c in CONDITIONS}\n",
     "for ci, (c, w, s) in enumerate(kept):\n",
     "    if ci % 10 == 0: print(f\"  logit lens {ci}/{len(kept)}\", flush=True)\n",
     "    for cond in CONDITIONS:\n",
     "        ids = tok(make_ab(s,c,w,True,cond), return_tensors=\"pt\").input_ids.to(\"cuda\")\n",
     "        rows = logit_lens(ids)\n",
     "        ll_res[cond].append([r[0]/(r[0]+r[1]) for r in rows])\n",
     "\n",
     "arr = {c: np.array(ll_res[c]) for c in CONDITIONS}\n",
     "print({c: arr[c].shape for c in CONDITIONS})\n",
     "\n",
     "# Fig 1 \u2013 logit lens\n",
     "fig, ax = plt.subplots(figsize=(10,5))\n",
     "cols = {\"neutral\":\"#2196F3\",\"mention\":\"#9C27B0\",\"weak\":\"#FF9800\",\"strong\":\"#F44336\",\"expert\":\"#4CAF50\"}\n",
     "for cond in CONDITIONS:\n",
     "    a = arr[cond]; mu = a.mean(0); se = a.std(0)/np.sqrt(len(a)); x = range(N_LAYERS)\n",
     "    ax.plot(x, mu, label=cond, color=cols[cond], lw=2)\n",
     "    ax.fill_between(x, mu-se, mu+se, alpha=0.15, color=cols[cond])\n",
     "ax.set_xlabel(\"Layer\"); ax.set_ylabel(\"P(correct)\")\n",
     "ax.set_title(\"Prior Strength \u2014 logit lens (A/B, 5 conditions)\")\n",
     "ax.legend(); ax.set_ylim(0,1); plt.tight_layout()\n",
     "plt.savefig(\"/content/fig1_logit_lens.png\", dpi=150); plt.show()\n",
     "print(\"Fig 1 saved\")\n",
     "\n",
     "# \u2500\u2500 5. Direction estimation (train split only) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
     "LAYER = 24\n",
     "\n",
     "def get_hidden(prompt, li):\n",
     "    ids = tok(prompt, return_tensors=\"pt\").input_ids.to(\"cuda\")\n",
     "    with torch.no_grad():\n",
     "        out = model(ids, output_hidden_states=True)\n",
     "    return out.hidden_states[li+1][0,-1].float()\n",
     "\n",
     "diffs = [\n",
     "    get_hidden(make_ab(s,c,w,True,\"strong\"), LAYER) -\n",
     "    get_hidden(make_ab(s,c,w,True,\"neutral\"), LAYER)\n",
     "    for c,w,s in train_qs\n",
     "]\n",
     "direction = torch.stack(diffs).mean(0)\n",
     "print(f\"Direction norm before normalization: {direction.norm().item():.4f}\")\n",
     "direction = direction / direction.norm()\n",
     "\n",
     "rand = torch.randn_like(direction)\n",
     "rand = rand - (rand @ direction) * direction\n",
     "rand = rand / rand.norm()\n",
     "print(f\"Direction and random control ready. Layer={LAYER}\")\n",
     "\n",
     "# \u2500\u2500 6. Causal sweep (test split, single layer, correct hook) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
     "ALPHAS = [0.0, 0.25, 0.5, 1.0]\n",
     "\n",
     "def run_with_hook(prompt, cor_A, li, vec, alpha):\n",
     "    ids = tok(prompt, return_tensors=\"pt\").input_ids.to(\"cuda\")\n",
     "    def hk(m, inp, output):\n",
     "        if isinstance(output, tuple):\n",
     "            h = output[0] - alpha * vec.to(output[0].dtype).to(output[0].device)\n",
     "            return (h,) + output[1:]\n",
     "        else:\n",
     "            return output - alpha * vec.to(output.dtype).to(output.device)\n",
     "    handle = model.model.layers[li].register_forward_hook(hk)\n",
     "    with torch.no_grad():\n",
     "        out = model(ids)\n",
     "    handle.remove()\n",
     "    logits = out.logits[0,-1].float()\n",
     "    p = torch.softmax(logits, dim=-1)\n",
     "    pa, pb = p[A_ID].item(), p[B_ID].item()\n",
     "    return (pa/(pa+pb)) if cor_A else (pb/(pa+pb))\n",
     "\n",
     "CR = {(\"r\",a): [] for a in ALPHAS}\n",
     "CR.update({(\"x\",a): [] for a in ALPHAS})\n",
     "\n",
     "for qi, (c,w,s) in enumerate(test_qs):\n",
     "    if qi % 5 == 0: print(f\"  causal sweep {qi}/{len(test_qs)}\", flush=True)\n",
     "    pr = make_ab(s,c,w,True,\"strong\")\n",
     "    for a in ALPHAS:\n",
     "        CR[(\"r\",a)].append(run_with_hook(pr, True, LAYER, direction, a))\n",
     "        CR[(\"x\",a)].append(run_with_hook(pr, True, LAYER, rand, a))\n",
     "\n",
     "print(\"\\nCausal sweep results:\")\n",
     "for k,v in CR.items():\n",
     "    print(f\"  {str(k):15s}  mean P(correct)={np.mean(v):.3f}\")\n",
     "\n",
     "nb_scores = [run_with_hook(make_ab(s,c,w,True,\"neutral\"), True, LAYER, direction, 0.0)\n",
     "             for c,w,s in test_qs]\n",
     "print(f\"  neutral baseline: {np.mean(nb_scores):.3f}\")\n",
     "\n",
     "# Fig 2 \u2013 causal sweep\n",
     "fig, ax = plt.subplots(figsize=(9,5))\n",
     "xs = np.array(ALPHAS)\n",
     "ax.axhline(np.mean(nb_scores), color=\"#2196F3\", ls=\"--\", lw=1.5, label=\"neutral baseline\")\n",
     "ax.plot(xs, [np.mean(CR[(\"r\",a)]) for a in ALPHAS], \"o-\", color=\"#F44336\", lw=2, ms=7, label=\"real direction\")\n",
     "ax.plot(xs, [np.mean(CR[(\"x\",a)]) for a in ALPHAS], \"s--\", color=\"#9E9E9E\", lw=2, ms=7, label=\"random control\")\n",
     "ax.set_xlabel(\"alpha\"); ax.set_ylabel(\"P(correct)\")\n",
     "ax.set_title(f\"Causal sweep \u2014 single subtraction at layer {LAYER}\")\n",
     "ax.set_xticks(ALPHAS); ax.legend(); ax.set_ylim(0,1); plt.tight_layout()\n",
     "plt.savefig(\"/content/fig2_causal_sweep.png\", dpi=150); plt.show()\n",
     "print(\"Fig 2 saved\")\n",
     "\n",
     "# \u2500\u2500 7. Activation patching \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
     "def get_all_hidden(prompt):\n",
     "    ids = tok(prompt, return_tensors=\"pt\").input_ids.to(\"cuda\")\n",
     "    with torch.no_grad():\n",
     "        out = model(ids, output_hidden_states=True)\n",
     "    return [h[0,-1].float() for h in out.hidden_states[1:]]\n",
     "\n",
     "PR = []\n",
     "for qi, (c,w,s) in enumerate(test_qs):\n",
     "    if qi % 5 == 0: print(f\"  patching {qi}/{len(test_qs)}\", flush=True)\n",
     "    nh = get_all_hidden(make_ab(s,c,w,True,\"neutral\"))\n",
     "    ps = make_ab(s,c,w,True,\"strong\")\n",
     "    ids = tok(ps, return_tensors=\"pt\").input_ids.to(\"cuda\")\n",
     "    row = []\n",
     "    for li in range(N_LAYERS):\n",
     "        cv = nh[li].clone()\n",
     "        def hk(m, inp, output, v=cv):\n",
     "            if isinstance(output, tuple):\n",
     "                h = output[0].clone(); h[0,-1] = v.to(h.dtype).to(h.device)\n",
     "                return (h,) + output[1:]\n",
     "            else:\n",
     "                h = output.clone(); h[0,-1] = v.to(h.dtype).to(h.device); return h\n",
     "        handle = model.model.layers[li].register_forward_hook(hk)\n",
     "        with torch.no_grad():\n",
     "            out = model(ids)\n",
     "        handle.remove()\n",
     "        logits = out.logits[0,-1].float()\n",
     "        p = torch.softmax(logits, dim=-1)\n",
     "        pa, pb = p[A_ID].item(), p[B_ID].item()\n",
     "        row.append(pa/(pa+pb))\n",
     "    PR.append(row)\n",
     "\n",
     "PA = np.array(PR)\n",
     "print(f\"Patching array shape: {PA.shape}\")\n",
     "\n",
     "strong_base = np.mean([run_with_hook(make_ab(s,c,w,True,\"strong\"), True, LAYER, direction, 0.0)\n",
     "                       for c,w,s in test_qs])\n",
     "neutral_base = np.mean(nb_scores)\n",
     "\n",
     "# Fig 3 \u2013 patching\n",
     "mu = PA.mean(0); se = PA.std(0)/np.sqrt(len(PA))\n",
     "fig, ax = plt.subplots(figsize=(10,5))\n",
     "ax.plot(range(N_LAYERS), mu, color=\"#4CAF50\", lw=2, label=\"patched neutral->strong\")\n",
     "ax.fill_between(range(N_LAYERS), mu-se, mu+se, alpha=0.2, color=\"#4CAF50\")\n",
     "ax.axhline(neutral_base, color=\"#2196F3\", ls=\"--\", lw=1.5, label=f\"neutral baseline ({neutral_base:.3f})\")\n",
     "ax.axhline(strong_base,  color=\"#F44336\", ls=\"--\", lw=1.5, label=f\"strong no patch ({strong_base:.3f})\")\n",
     "ax.set_xlabel(\"Patch layer\"); ax.set_ylabel(\"P(correct)\")\n",
     "ax.set_title(\"Clean activation patching: neutral -> strong\")\n",
     "ax.legend(); ax.set_ylim(0,1); plt.tight_layout()\n",
     "plt.savefig(\"/content/fig3_patching.png\", dpi=150); plt.show()\n",
     "print(\"Fig 3 saved\")\n",
     "\n",
     "# \u2500\u2500 8. Save results \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
     "np.save(\"/content/results_v2.npy\", {\n",
     "    \"logit_lens\":   {c: arr[c] for c in CONDITIONS},\n",
     "    \"causal_real\":  {a: np.array(CR[(\"r\",a)]) for a in ALPHAS},\n",
     "    \"causal_rand\":  {a: np.array(CR[(\"x\",a)]) for a in ALPHAS},\n",
     "    \"patching\":     PA,\n",
     "    \"n_train\":      HALF,\n",
     "    \"n_test\":       len(test_qs),\n",
     "    \"layer\":        LAYER,\n",
     "})\n",
     "print(\"Saved /content/results_v2.npy\")\n",
     "from google.colab import files\n",
     "files.download(\"/content/results_v2.npy\")"
    ],
