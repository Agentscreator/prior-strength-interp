     "# Run logit lens on all 40 prompts (20 neutral + 20 bait)\n",
     "neutral_correct, neutral_wrong = [], []\n",
     "bait_correct, bait_wrong = [], []\n",
     "final_answers = []\n",
     "\n",
     "for i, (neutral, bait, correct_str, wrong_str) in enumerate(pairs):\n",
     "    print(f\"  Pair {i+1}/20\", flush=True)\n",
     "    nc, nw = logit_lens_prompt(neutral, correct_str, wrong_str)\n",
     "    bc, bw = logit_lens_prompt(bait, correct_str, wrong_str)\n",
     "    neutral_correct.append(nc); neutral_wrong.append(nw)\n",
     "    bait_correct.append(bc); bait_wrong.append(bw)\n",
     "\n",
     "    bait_gap_final = bc[-1] - bw[-1]\n",
     "    neutral_gap_final = nc[-1] - nw[-1]\n",
     "    flipped = bool((neutral_gap_final > 0) and (bait_gap_final < 0))\n",
     "    final_answers.append({\n",
     "        'q': correct_str + ' vs ' + wrong_str,\n",
     "        'neutral_gap': float(neutral_gap_final),\n",
     "        'bait_gap': float(bait_gap_final),\n",
     "        'flipped': flipped,\n",
     "        'weakened_by': float(neutral_gap_final - bait_gap_final)\n",
     "    })\n",
     "\n",
     "import numpy as np\n",
     "neutral_correct = np.stack(neutral_correct)  # [20, 28]\n",
     "neutral_wrong = np.stack(neutral_wrong)\n",
     "bait_correct = np.stack(bait_correct)\n",
     "bait_wrong = np.stack(bait_wrong)\n",
     "\n",
     "neutral_gap = neutral_correct - neutral_wrong  # [20, 28]\n",
     "bait_gap    = bait_correct    - bait_wrong\n",
     "neutral_gap_mean = neutral_gap.mean(axis=0)   # [28]\n",
     "bait_gap_mean    = bait_gap.mean(axis=0)\n",
     "\n",
     "split_by_layer = neutral_gap_mean - bait_gap_mean\n",
     "headline_layer = int(np.argmax(split_by_layer))\n",
     "print(f\"\\nHeadline: lines diverge most at layer {headline_layer}\")\n",
     "print(f\"Max divergence: {split_by_layer[headline_layer]:.2f}\")\n",
     "print(f\"\\nFlipped questions (model gives wrong answer when pressured):\")\n",
     "for fa in final_answers:\n",
     "    if fa['flipped']:\n",
     "        print(f\"  {fa['q']}  (neutral={fa['neutral_gap']:.1f}, bait={fa['bait_gap']:.1f})\")\n",
     "\n",
     "print(\"\\nAll questions weakened_by (neutral_gap - bait_gap):\")\n",
     "for fa in sorted(final_answers, key=lambda x: -x['weakened_by']):\n",
     "    print(f\"  {fa['q']:30s}  delta={fa['weakened_by']:.2f}\")"
    ],
