     "NUM_LAYERS = model.config.num_hidden_layers  # 28\n",
     "ALL_LAYERS = list(range(NUM_LAYERS))\n",
     "\n",
     "def logit_lens_prompt(prompt, correct_str, wrong_str):\n",
     "    correct_id = tokenizer.encode(correct_str, add_special_tokens=False)[0]\n",
     "    wrong_id   = tokenizer.encode(wrong_str,   add_special_tokens=False)[0]\n",
     "    saved = {}\n",
     "    with model.trace(prompt):\n",
     "        for L in ALL_LAYERS:\n",
     "            saved[L] = model.model.layers[L].output[0].save()\n",
     "    correct_logits = []\n",
     "    wrong_logits   = []\n",
     "    with torch.no_grad():\n",
     "        norm_w = model.model.norm.weight.detach()\n",
     "        lm_w = model.lm_head.weight.detach()\n",
     "        for L in ALL_LAYERS:\n",
     "            h = saved[L][-1, :].detach()\n",
     "            rms = h.pow(2).mean().sqrt() + 1e-6\n",
     "            h_norm = (h / rms) * norm_w\n",
     "            logits = h_norm @ lm_w.T\n",
     "            correct_logits.append(logits[correct_id].item())\n",
     "            wrong_logits.append(logits[wrong_id].item())\n",
     "    return np.array(correct_logits), np.array(wrong_logits)\n",
     "\n",
     "print(\"logit_lens_prompt defined, NUM_LAYERS =\", NUM_LAYERS)"
    ],
